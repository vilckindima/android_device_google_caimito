<!--
     Google charging optimization (adaptive charging, limit to 80%) and battery
     health pages. lineage-component-overrides.xml turns them off in /product;
     /system_ext is read later, so these entries win.
-->
<config>
    <component-override package="com.google.android.settings.intelligence">
        <component class="com.google.android.settings.intelligence.modules.battery.impl.chargingoptimization.ChargingOptimizationActivity" enabled="true" />
        <component class="com.google.android.settings.intelligence.modules.battery.impl.chargingoptimization.ChargingOptimizationActivityInject" enabled="true" />
        <component class="com.google.android.settings.intelligence.modules.battery.impl.chargingoptimization.ChargingOptimizationBootBroadcastReceiver" enabled="true" />
        <component class="com.google.android.settings.intelligence.modules.battery.impl.chargingoptimization.ChargingOptimizationSearchIndexablesProvider" enabled="true" />
        <component class="com.google.android.settings.intelligence.modules.battery.impl.health.BHSettingsActivity" enabled="true" />
    </component-override>
</config>
